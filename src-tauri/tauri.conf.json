{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Splitter",
  "version": "0.1.0",
  "identifier": "com.modelsplitter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Model Splitter",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Split STL, OBJ, and 3MF models for multi-colour 3D printing",
    "longDescription": "Load STL, OBJ, or 3MF meshes, repair open boundaries, add topology-aware cut planes and alignment connectors, and export watertight per-part STL files.",
    "copyright": "© 2026 Model Splitter contributors",
    "macOS": {
      "minimumSystemVersion": "11.3",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "entitlements": null,
      "exceptionDomain": null,
      "signingIdentity": null,
      "providerShortName": null
    },
    "fileAssociations": [
      {
        "ext": [
          "stl"
        ],
        "name": "STL 3D Model",
        "description": "Stereolithography 3D model",
        "role": "Editor",
        "mimeType": "model/stl"
      },
      {
        "ext": [
          "obj"
        ],
        "name": "Wavefront OBJ",
        "description": "Wavefront OBJ 3D model",
        "role": "Editor",
        "mimeType": "model/obj"
      },
      {
        "ext": [
          "3mf"
        ],
        "name": "3D Manufacturing Format",
        "description": "3MF manufacturing model",
        "role": "Editor",
        "mimeType": "model/3mf"
      }
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STL Segmenter",
  "version": "0.1.0",
  "identifier": "com.stlsegmenter.app",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "STL Segmenter",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "fileDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**"]
      }
    },
    "macOSPrivateApi": true
  },

  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "AI-powered STL segmenter for multi-colour 3D printing",
    "longDescription": "Load STL / OBJ / 3MF meshes, let the topology-aware planner find optimal cut planes, and export watertight per-part STLs ready for AMS-style multi-colour 3D printing.",
    "copyright": "© 2026",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": { "windowSize": { "width": 660, "height": 400 } },
      "entitlements": null,
      "exceptionDomain": null,
      "signingIdentity": null,
      "providerShortName": null
    },
    "fileAssociations": [
      {
        "ext": ["stl"],
        "name": "STL 3D Model",
        "description": "Stereolithography 3D model",
        "role": "Editor",
        "mimeType": "model/stl"
      },
      {
        "ext": ["obj"],
        "name": "Wavefront OBJ",
        "description": "Wavefront OBJ 3D model",
        "role": "Editor",
        "mimeType": "model/obj"
      },
      {
        "ext": ["3mf"],
        "name": "3D Manufacturing Format",
        "description": "3MF 3D model",
        "role": "Editor",
        "mimeType": "model/3mf"
      }
    ]
  }
}
